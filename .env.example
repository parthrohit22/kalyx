# Optional local API key for protected FastAPI operational endpoints.
# Leave unset for open local development behavior.
KALYX_API_KEY=example-dev-key

# Host-to-anchor URL. Use a reachable Pi address for multi-machine demos.
KALYX_ANCHOR_URL=http://127.0.0.1:8081

# Ledger identifier submitted to and queried from the anchor authority.
KALYX_LEDGER_ID=kalyx-main-host
